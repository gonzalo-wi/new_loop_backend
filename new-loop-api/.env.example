# Copiar a .env y completar con valores reales antes de levantar los contenedores.

# --- Base de datos (externa, ya existente) ---
# La base NO se crea en Docker: la app apunta a una base PostgreSQL que ya tenés.
# Ejemplos de DB_URL:
#   - Base en el MISMO servidor (host):  jdbc:postgresql://host.docker.internal:5432/loop_new_db
#   - Base en OTRO server de la LAN:     jdbc:postgresql://192.168.0.XX:5432/loop_new_db
DB_URL=jdbc:postgresql://host.docker.internal:5432/loop_new_db
DB_USERNAME=loop
DB_PASSWORD=cambiar_esta_password

# --- Seguridad ---
# Clave secreta para firmar los JWT (usar 64+ caracteres hex aleatorios)
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# --- Integración Aguas ---
# Nota: productos (in/out) y equipment/dispensers hoy están en el mismo host, pero son
# configuraciones separadas por si Aguas vuelve a moverlas a hosts distintos.
AGUAS_BASE_URL=http://192.168.0.58
AGUAS_EQUIPMENT_BASE_URL=http://192.168.0.58

# --- Integración Odoo ---
# Odoo repair intake (dispensers UNLOAD -> reparación).
ODOO_BASE_URL=https://ivess-stage-30117855.dev.odoo.com
ODOO_API_KEY=cambiar_api_key
# Odoo dispatch/salida (dispensers LOAD -> reparto), ambiente/módulo separado del anterior.
ODOO_DISPATCH_BASE_URL=https://ivess-stage-36643580.dev.odoo.com
ODOO_DISPATCH_API_KEY=cambiar_api_key

# --- Integración Powerfleet (ubicación GPS de camiones) ---
POWERFLEET_BASE_URL=https://www.monitoreodeflotas.com.ar/Fleetcore.Api
POWERFLEET_USERNAME=cambiar_usuario
POWERFLEET_PASSWORD=cambiar_password

# --- Observabilidad (Prometheus + Grafana) ---
# Puerto en el que escucha la app (usado también por Prometheus para armar la URL de scrape).
PORT=8096
# Credenciales dedicadas para que Prometheus scrapee /actuator/** vía HTTP Basic (no son las del login de usuarios).
ACTUATOR_USERNAME=prometheus
ACTUATOR_PASSWORD=cambiar_esta_password
# Credenciales del usuario admin de Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_esta_password
